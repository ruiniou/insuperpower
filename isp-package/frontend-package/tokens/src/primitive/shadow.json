{
  "shadow": {
    "$type": "shadow",
    "button": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "#0000000F"
        },
        {
          "offsetX": "1px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "#0000000A"
        }
      ]
    },
    "layer": {
      "$value": [
        {
          "offsetX": "1px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px",
          "color": "#00000014"
        },
        {
          "offsetX": "0px",
          "offsetY": "3px",
          "blur": "8px",
          "spread": "0px",
          "color": "#0000000D"
        }
      ]
    },
    "overlay": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "16px",
          "spread": "0px",
          "color": "#00000014"
        }
      ]
    },
    "popover": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px",
          "color": "#0000001A"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "#0000000F"
        }
      ]
    },
    "modal": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "48px",
          "spread": "0px",
          "color": "#0000002E"
        }
      ]
    },
    "ring-hairline": {
      "$value": [
        {
          "inset": true,
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "{palette.grey.40}"
        }
      ]
    }
  }
}
